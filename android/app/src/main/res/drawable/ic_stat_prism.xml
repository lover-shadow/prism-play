<?xml version="1.0" encoding="utf-8"?>
<!--
  Notification small icon (status-bar silhouette): a prism bar driving a play wedge.
  Lucide-geometry discipline (SPEC 8 / P0-1): 24x24 viewport, 2-unit stroke, round
  caps and joins, flat white so the system can tint it; no bitmap, no emoji, and no
  literal colour code anywhere (P0-3 bans raw hex even in res/).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M4 3v18"
        android:strokeColor="@android:color/white"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M9 5l11 7-11 7z"
        android:strokeColor="@android:color/white"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
