<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  《光影Play》(Prism Play) v2.0 - network security configuration
  ARCHITECTURE 3.1: the client only ever talks to the unified edge domain
  `play.prismos.org`; real upstream hosts exist only in D1 and must stay there
  (de-platforming rule, AGENTS.md 二.1). Cleartext is off for every host, so a
  captive-portal style downgrade cannot reach the media proxy or /api/redeem.

  LIVE RELOAD IS DELIBERATELY NOT PRE-APPROVED HERE: running `npx cap run android` in live
  reload mode loads the WebView from http LAN address port 5173 and needs a cleartext exception for
  that host. Add it only inside a scratch copy of this file during a device session and never commit
  it, otherwise a development convenience becomes a release-build downgrade hole.
  ============================================================================
-->
<network-security-config>

    <!-- No cleartext anywhere, and only the platform trust store is honoured: a
         user-installed CA (corporate proxy / Charles on a rooted phone) must not be
         able to terminate TLS for an app whose JWT and private-session headers ride
         that connection. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="false">
        <!-- Single allowed peer. Pinning (pin-set) is intentionally NOT declared here:
             a wrong or rotated leaf hash bricks both playback and the OTA path at
             /dl/latest/android, and the certificate rotation policy for the edge is not
             part of the v2.0 contract. Decide it with real evidence at G4. -->
        <domain includeSubdomains="false">play.prismos.org</domain>
    </domain-config>

    <!-- Debug builds only: accept user-added roots so a proxy can be used to observe
         HLS Range/206 behaviour during the Stage 3 device pass. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
