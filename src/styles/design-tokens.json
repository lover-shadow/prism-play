{
  "$schema": "https://tr.designtokens.org/format/",
  "meta": {
    "project": "光影Play (Prism Play) · 商业版",
    "legacyAlias": "光影短剧 / Guangying Short Drama（旧品牌名，已废弃，仅历史文档可追溯）",
    "version": "2.0.0",
    "register": "Product",
    "sourceOfTruth": "src/styles/design-tokens.css",
    "syncRule": "本文件为 CSS 的机读镜像；色值、断点、动效必须与 design-tokens.css 同源，任一侧变更须同步另一侧。",
    "iconSystem": {
      "library": "Lucide Icons (Inline SVG Sprite / 2px Stroke)",
      "viewBox": "0 0 24 24",
      "strokeWidth": "2",
      "strokeLinecap": "round",
      "strokeLinejoin": "round",
      "sizes": {
        "inline": "16px",
        "button": "20px",
        "standalone": "24px"
      },
      "emojiForbidden": true
    },
    "designDial": {
      "DESIGN_VARIANCE": 5,
      "MOTION_INTENSITY": 4,
      "VISUAL_DENSITY": 6
    },
    "contrastPolicy": {
      "bodyText": "≥ 4.5:1",
      "uiComponent": "≥ 3:1",
      "accentOnLightTheme": "浅色 --accent 背景上的前景取 --accent-on: #131720（深色字），禁止白字",
      "metaUsage": "--meta 仅用于角标/版本等辅助信息，不得承载正文段落"
    },
    "easingsForbidden": ["bounce", "elastic", "back"]
  },
  "breakpoints": {
    "tablet": { "value": "768px", "type": "dimension", "description": "平板/折叠屏断点，与 CSS @media (min-width: 768px) 一致" },
    "desktop": { "value": "1024px", "type": "dimension", "description": "桌面/电视断点，与 CSS @media (min-width: 1024px) 一致" }
  },
  "themes": {
